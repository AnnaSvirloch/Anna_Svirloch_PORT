<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Anna Švirlochová | Fagotistka</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@500;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="style.css">
</head>
<body>

  <header>
    <nav>
      <h1>Anna Švirlochová</h1>

      <ul>
        <li><a href="#about">O mně</a></li>
        <li><a href="#cv">CV</a></li>
        <li><a href="#contact">Kontakt</a></li>
      </ul>
    </nav>
  </header>

  <section class="hero">

    <div class="hero-text">
      <h2>Fagotistka</h2>

      <p>
        Studentka fagotu na Pražské konzervatoři
        pod vedením prof. Kořínka.
      </p>

      <a href="#contact" class="btn">
        Kontakt
      </a>
    </div>

    <div class="hero-image">
      <img src="images/profile.jpg" alt="Anna Švirlochová">
    </div>

  </section>

  <section id="about" class="section">
    <h2>O mně</h2>

    <p>
      Jsem studentka fagotu na Pražské konzervatoři pod vedením
      prof. Kořínka.
    </p>

    <p>
      Hudbě se věnuji od dětství. Studovala jsem na
      ZUŠ Hálková Bratislava pod vedením p. uč. Košického
      a následně absolvovala přípravné studium na
      Konzervatóriu Tolstého v Bratislavě pod vedením
      prof. Rottera.
    </p>

    <p>
      Působím v orchestru
      <a href="https://istropolisconcertband.sk/" target="_blank">
        Istropolis Concert Band
      </a>
      a také v symfonickém orchestru
      <a href="https://orchesterdominanta.sk/" target="_blank">
        Dominanta
      </a>.
    </p>
  </section>

  <section id="cv" class="section">
    <h2>CV</h2>

    <div class="timeline">

      <div class="timeline-item">
        <span>ZUŠ Hálková Bratislava</span>
        <p>Studium pod vedením p. uč. Košického</p>
      </div>

      <div class="timeline-item">
        <span>Konzervatórium Tolstého Bratislava</span>
        <p>Přípravné studium pod vedením prof. Rottera</p>
      </div>

      <div class="timeline-item">
        <span>Pražská konzervatoř</span>
        <p>Aktuální studium fagotu pod vedením prof. Kořínka</p>
      </div>

    </div>
  </section>

  <section id="contact" class="section">
    <h2>Kontakt</h2>

    <div class="socials">

      <a href="#" target="_blank">
        Instagram
      </a>

      <a href="#" target="_blank">
        Facebook
      </a>

      <a href="mailto:anna@email.com">
        anna@email.com
      </a>

    </div>
  </section>

  <footer>
    <p>
      © 2026 Anna Švirlochová
    </p>
  </footer>

  <script src="script.js"></script>
</body>
</html>